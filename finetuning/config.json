{
  "upstream_dir": "vendor/SongFormer",
  "labeled_dir": "outputs.local/labeled",
  "reviewed_dir": "outputs.local/reviewed",
  "work_dir": "outputs.local/finetuning",
  "checkpoint": "vendor/SongFormer/src/SongFormer/ckpts/SongFormer.safetensors",
  "seed": 42,
  "split_ratios": [0.8, 0.1, 0.1],
  "features": {
    "sample_rate": 24000,
    "encoder_layer": 10,
    "short_window_seconds": 30,
    "long_window_seconds": 120,
    "head_window_seconds": 420,
    "encoder_fps": 25,
    "stride": 3,
    "storage_dtype": "float32",
    "muq_repo": "OpenMuQ/MuQ-large-msd-iter"
  },
  "training": {
    "trainable": "function_head",
    "epochs": 20,
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "gradient_accumulation": 4,
    "max_grad_norm": 1.0,
    "patience": 4
  }
}
